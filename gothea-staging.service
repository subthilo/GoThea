[Unit]
Description=GoThea Web App (Staging)
After=network.target

[Service]
Type=simple
User=pi
# Eigener Code-Ordner: ein Deploy auf Staging erreicht die Produktion nicht. Daten, Inbox und
# KI-Schlüssel stehen in /home/pi/GoThea-staging/.env (die Daten selbst bleiben unter ~/GoThea/data/staging).
WorkingDirectory=/home/pi/GoThea-staging
Environment=APP_ENV=staging
ExecStart=/home/pi/GoThea-staging/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
